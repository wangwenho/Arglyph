{
  "name": "arglyph",
  "version": "1.0.0",
  "description": "Browse, preview and inspect CJK fonts glyph by glyph.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "displayName": "Arglyph",
  "publisher": "wangwenho",
  "icon": "assets/package/icon.png",
  "galleryBanner": {
    "color": "#FAFAFD",
    "theme": "light"
  },
  "categories": [
    "Visualization",
    "Education",
    "Other"
  ],
  "keywords": [
    "font",
    "font viewer",
    "glyph",
    "cjk",
    "chinese",
    "japanese",
    "korean",
    "ttf",
    "otf",
    "unicode"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wangwenho/vscode-arglyph.git"
  },
  "bugs": {
    "url": "https://github.com/wangwenho/vscode-arglyph/issues"
  },
  "homepage": "https://github.com/wangwenho/vscode-arglyph#readme",
  "qna": "https://github.com/wangwenho/vscode-arglyph/issues",
  "main": "./out/extension.cjs",
  "engines": {
    "vscode": "^1.101.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "arglyph.open",
        "title": "Arglyph: Open Font…"
      },
      {
        "command": "arglyph.copyCodePoint",
        "title": "Copy Code Point"
      },
      {
        "command": "arglyph.copyCharacter",
        "title": "Copy Character"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "arglyph.copyCodePoint",
          "when": "false"
        },
        {
          "command": "arglyph.copyCharacter",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "arglyph.copyCodePoint",
          "when": "webviewSection == 'arglyph.glyph'",
          "group": "copy@1"
        },
        {
          "command": "arglyph.copyCharacter",
          "when": "webviewSection == 'arglyph.glyph' && arglyph.hasCharacter",
          "group": "copy@2"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "wangwenho.arglyph",
        "displayName": "Arglyph",
        "selector": [
          {
            "filenamePattern": "*.ttf"
          },
          {
            "filenamePattern": "*.otf"
          },
          {
            "filenamePattern": "*.TTF"
          },
          {
            "filenamePattern": "*.OTF"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "biome check",
    "format": "biome check --write",
    "build": "pnpm run build:extension && pnpm run build:webview",
    "build:extension": "vite build -c vite.extension.config.ts",
    "build:webview": "vite build -c vite.webview.config.ts",
    "vscode:prepublish": "pnpm run typecheck && pnpm run build",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.ts",
    "bench": "node scripts/bench.ts",
    "fetch:fixtures": "node scripts/fixtures/fetch-fixtures.ts",
    "fetch:unicode": "node scripts/unicode/fetch-unicode.ts",
    "gen:unicode": "node scripts/unicode/gen-unicode.ts",
    "gen:notices": "node scripts/gen-notices.ts",
    "e2e:host": "pnpm run build:extension && node scripts/e2e-host.cts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.19.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.101.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/vsce": "^4.1.1",
    "husky": "^9.1.7",
    "opentype.js": "^2.0.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
