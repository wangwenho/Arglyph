{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* The end-to-end checks and the benchmark: Node runs them as TypeScript,
       and the functions they hand to Playwright's page.evaluate run in the
       browser, so they need the DOM types as well. Checked, not emitted. */
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": ["scripts/e2e.ts", "scripts/e2e/**/*.ts", "scripts/bench.ts"]
}
